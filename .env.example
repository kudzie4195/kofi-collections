# Data mode: "mock" runs entirely on-device with fictional seed data (default).
# "supabase" uses the Supabase project below (apply supabase/migrations first).
VITE_DATA_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase mode only. Artist self sign-up: "on" or "off" (default off when unset).
# Keep it off on a project shared with another product: its own auth.users trigger
# would get a profile row for every Kofi sign-up (docs/SUPABASE.md §11).
VITE_KOFI_SIGNUP=off
# Optional: the public app URL (sign-up email redirect, and the base of the link back
# to an artist's page that verifies a link). Default: the current page.
VITE_KOFI_PUBLIC_URL=
